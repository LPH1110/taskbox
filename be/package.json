{
  "name": "taskbox-be",
  "version": "1.0.0",
  "description": "Backend for Taskbox application using Express, PostgreSQL, Prisma, and Socket.IO",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc && tsc prisma/seed.ts --outDir dist/prisma --module commonjs --esModuleInterop --target es2022 --moduleResolution node --skipLibCheck",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "test:load": "bash scripts/load-test/run-benchmarks.sh",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.0.0",
    "@aws-sdk/client-s3": "^3.540.0",
    "@aws-sdk/s3-request-presigner": "^3.540.0",
    "@prisma/client": "^5.11.0",
    "axios": "^1.17.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.78.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": ">=2.1.1",
    "nodemailer": ">=8.0.5",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "socket.io": "^4.7.5",
    "swagger-ui-express": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.30",
    "@types/nodemailer": "^6.4.14",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/passport-jwt": "^4.0.1",
    "@types/swagger-ui-express": "^4.1.6",
    "jest": "^30.4.2",
    "jest-mock-extended": "^4.0.1",
    "nodemon": "^3.1.0",
    "prisma": "^5.11.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3"
  },
  "prisma": {
    "seed": "node dist/prisma/seed.js"
  }
}